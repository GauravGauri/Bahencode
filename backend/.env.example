# Express Server Port (Render sets this dynamically, but defaults to 5000)
PORT=5000

# MongoDB Connection String (Atlas URI required for Render deployment)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/<database-name>?retryWrites=true&w=majority

# JWT Authentication Config
# Generate a strong secret key for token signing
JWT_SECRET=super_secret_behencode_key_2026_framer_motion_threejs
JWT_EXPIRES_IN=7d

# Ethereal Email Credentials for Testing
# Leave these blank if you want the app to auto-generate a temporary test email account.
# Fill them with real credentials (e.g. SMTP server, Gmail App Passwords) for production.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@behencode.co

# Default Seed Admin User (Created automatically on database connection if table is empty)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@behencode.co
ADMIN_PASSWORD=BehencodeAdmin123!
